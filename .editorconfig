root = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official # Official code style
max_line_length = 140
ij_kotlin_packages_to_use_import_on_demand = false # Disable wildcard
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, ^ # default IntelliJ IDEA style, same as alphabetical, but with "java", "javax", "kotlin" and alias imports in the end of the imports list
ktlint_standard_multiline-if-else = enabled
ktlint_chain_method_rule_force_multiline_when_chain_operator_count_greater_or_equal_than = 2

[{*.xml,*.xsd}]
max_line_length = 500
